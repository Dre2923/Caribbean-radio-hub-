# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL=postgres://caribbean:caribbean@localhost:5432/caribbean_radio_hub
PGSSL=false
# PGSSL_REJECT_UNAUTHORIZED=false  # only for a provider with a trusted self-signed chain

# Auth
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-this-with-a-real-random-secret-at-least-32-chars-long
JWT_EXPIRES_IN=7d

# Reverse proxy / load balancer trust (see src/config/env.ts for the full
# explanation). Leave unset locally. In production, this API sits behind
# whatever terminates HTTPS (a load balancer, reverse proxy, or the hosting
# platform's edge) - set this to how many of those hops are yours, e.g.
# TRUST_PROXY=1 for a single load balancer in front of the app, so
# rate-limiting keys on the real client IP instead of the proxy's.
# TRUST_PROXY=1

# API docs (OpenAPI/Swagger UI at /docs). On by default outside production;
# set true here only if this deployment's API docs should be public.
# ENABLE_API_DOCS=true

# Frontend URL used to build the link inside transactional emails (e.g. the
# password-reset link: {FRONTEND_URL}/reset-password?token=...). Required
# in production; defaults to http://localhost:5173 otherwise.
# FRONTEND_URL=https://app.caribbeanradiohub.com

# Email (transactional outbox - see src/email/ and README.md "Password
# reset email delivery"). Leave SMTP_HOST unset to use the dev-only
# ConsoleEmailProvider, which logs emails instead of sending them - that
# is NOT safe for production. Works with any SMTP-speaking provider (AWS
# SES, Postmark, SendGrid, Mailgun, Resend, ...): set these to that
# provider's SMTP credentials, no provider-specific SDK required.
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASSWORD=replace-with-real-smtp-credentials
# EMAIL_FROM="Caribbean Radio Hub <no-reply@caribbeanradiohub.com>"

# How often (ms) the email outbox worker polls for pending emails to send.
# EMAIL_OUTBOX_INTERVAL_MS=10000

# How often (ms) the stream health-check worker (see README.md "Stream
# Reliability") sweeps every active station's own stream URL. Each tick is
# a real outbound request to a real third-party server, so this is
# deliberately much longer than the email outbox's interval - 5 minutes by
# default.
# STATION_HEALTH_CHECK_INTERVAL_MS=300000

# How often (ms) the auto-deactivation worker re-evaluates the active
# catalog against a 48h reliability window and curates off any station
# confirmed 0% reachable across enough checks over that window. That
# decision only meaningfully changes as check history accumulates, so this
# is deliberately much longer than the health-check sweep's own interval -
# 1 hour by default.
# STATION_AUTO_DEACTIVATION_INTERVAL_MS=3600000

# Admin bootstrap allowlist (comma-separated emails). Any account whose
# email appears here is promoted to the 'admin' role the moment it
# registers or logs in - see README.md "Authorization: user roles" and
# src/repositories/usersRepository.ts ensureBootstrapAdminRole. This is
# the only way to become an admin right now (no admin-management endpoint
# exists yet). Leave unset in development unless you're specifically
# testing admin-gated behavior; set to your own real account's email in
# any environment where you need admin access.
# ADMIN_EMAILS=you@caribbeanradiohub.com,ops@caribbeanradiohub.com

# Push notifications (see README.md "Push notifications (Step 53)"). Leave
# unset to use the dev-only ConsoleNotificationProvider (notifications are
# logged, never sent) - NOT safe for production. Set to the full,
# unmodified JSON content of a Firebase service-account key file
# (downloaded from the Firebase console: Project settings > Service
# accounts > Generate new private key) as a single-line JSON string, to
# enable real push delivery via the FCM HTTP v1 API.
# FCM_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"..."}
